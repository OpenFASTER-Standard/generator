@prefix xsdo: <https://purl.openfaster.org/xsdo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/test/> .

ex:AdresseType a xsdo:ComplexTypeDefinition ;
    xsdo:targetNamespace "urn:example:test:v1"^^xsd:anyURI ;
    xsdo:contentModel [
        a xsdo:Sequence ;
        xsdo:hasParticle [
            xsdo:particlePosition 1 ;
            xsdo:minOccurs 1 ;
            xsdo:maxOccurs 1 ;
            xsdo:term ex:Strasse
        ]
    ] .

ex:Adresse a xsdo:ElementDeclaration ;
    xsdo:name "Adresse" ;
    xsdo:type ex:AdresseType .

ex:Strasse a xsdo:ElementDeclaration ;
    xsdo:name "Strasse" ;
    xsdo:type ex:StrasseType .

ex:StrasseType a xsdo:SimpleTypeDefinition ;
    xsdo:minLength 1 ;
    xsdo:maxLength 80 .
