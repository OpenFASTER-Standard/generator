@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix review: <https://purl.openfaster.org/review/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

review:CorrectionShape a sh:NodeShape ;
    sh:targetClass review:Correction ;
    sh:property [
        sh:path review:status ;
        sh:hasValue "proposed" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path review:targetSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path review:targetPredicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    # Not sh:minCount/sh:maxCount 1 here (unlike the other properties above) --
    # existing minimal validation fixtures (tests/review/test_validate.py)
    # deliberately omit prov:generatedAtTime and must keep conforming. This
    # constraint only closes the "junk string accepted as a timestamp" hole:
    # sh:datatype correctly flags an ill-formed xsd:dateTime lexical value
    # (e.g. "not-a-timestamp") as a violation whenever the property IS present,
    # which is what corrupted every ordering-dependent guarantee in this
    # package (SPARQL ORDER BY DESC(?time), get_correction_status's sort).
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
    ] .

review:DecisionShape a sh:NodeShape ;
    sh:targetClass review:Decision ;
    sh:property [
        sh:path review:outcome ;
        sh:in ("approved" "rejected") ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path review:decides ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    # See review:CorrectionShape's identical property shape above for why this
    # has no minCount/maxCount.
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:sparql [
        sh:message "A Decision's reviewer must differ from the Correction's proposer (no self-approval)." ;
        sh:select """
            PREFIX review: <https://purl.openfaster.org/review/>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this review:decides ?correction ;
                      prov:wasAttributedTo ?decider .
                ?correction prov:wasAttributedTo ?proposer .
                FILTER (?decider = ?proposer)
            }
        """ ;
    ] .
